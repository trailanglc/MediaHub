APP_ENV=development
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
# Optional CDN origin for signed /assets and /embed URLs (nginx cache in front).
# CDN_PUBLIC_URL=https://cdn.example.com
API_ADDR=:8080

DB_DSN=postgres://mediahub:Anhtuanlc.12@localhost:5432/mediahub?sslmode=disable

REDIS_ADDR=localhost:6379
# Tự scale theo CPU/RAM khi bỏ trống (gateway log "autoscale" lúc khởi động):
# REDIS_POOL_SIZE=
# REDIS_MIN_IDLE_CONNS=
# DB_MAX_CONNS=
# DB_MIN_CONNS=
# REDIS_READ_TIMEOUT=3s
# REDIS_WRITE_TIMEOUT=3s

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mediahub
STORAGE_ACCESS_KEY=mediahub
STORAGE_SECRET_KEY=Anhtuanlc.12
STORAGE_USE_SSL=false
STORAGE_USE_PATH_STYLE=true

# JWT_SECRET được tạo bằng lệnh:
# openssl rand -hex 32
JWT_SECRET=6ade2951cf67c193dda9c5d7c88e9a8ebfc1b220c75cf541dee37fd4a8df468d
# SETUP_TOKEN được tạo bằng lệnh:
# openssl rand -hex 32
SETUP_TOKEN=a5ffa060fba672d4e7fc7425598217641284cbf86713c4525c7cd8a5fe09261e

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

STREAM_SIGNING_SECRET=change_me_stream_signing_secret
# Bỏ trống = tự scale theo CPU/RAM (max 90%); governor điều chỉnh runtime trong [MIN, MAX]
# CONVERT_MAX_CONCURRENT=
# CONVERT_MIN_CONCURRENT=
# CONVERT_QUEUE_MAX_DEPTH=   # pending+active Asynq; mặc định CONVERT_MAX×25 (50–200)
CONVERT_JOB_TIMEOUT=2h
STREAM_RATE_LIMIT_PER_MIN=120
# Origin segment fetch cap per IP/video/minute (fails open, never blocks playback).
# 0 derives 10x STREAM_RATE_LIMIT_PER_MIN.
STREAM_SEGMENT_RATE_LIMIT_PER_MIN=0
# Rolling validity window for shared, edge-cacheable signed segment URLs.
# All viewers within a window share the same URL so the CDN caches each segment once.
STREAM_SEGMENT_URL_TTL=1h
# Rolling validity window for signed image/thumbnail/embed delivery URLs (/assets, /embed).
ASSET_DELIVERY_URL_TTL=24h
# When set, the API returns X-Accel-Redirect for segments so an internal nginx location
# streams bytes directly from object storage (the API never touches segment bytes).
# Must match the internal location in deployments/nginx-reverse-proxy.example.conf.
# Leave empty to have the API stream segments itself (works without nginx).
STREAM_INTERNAL_REDIRECT_PREFIX=

# Reverse proxy CIDRs/IPs trusted for ClientIP (comma-separated). Default: 127.0.0.1,::1
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# Resource governor (adaptive CPU/RAM/Redis — bật mặc định, trần 90% CPU/RAM)
# RESOURCE_GOVERNOR_ENABLED=true
# RESOURCE_SAMPLE_INTERVAL=10s
# RESOURCE_CPU_RESERVE_PERCENT=   # bỏ trống = giữ ≥10% CPU idle (max 90% dùng)
# RESOURCE_RAM_MIN_IDLE_PERCENT=  # bỏ trống = ≥1 GiB headroom + max 90% RAM
# RESOURCE_REDIS_MAX_USED_PERCENT=85
# RESOURCE_GOVERNOR_PUBLISH=false

# Tối đa session upload chưa hoàn tất / user (init mới tự dọn session cũ nhất nếu đầy)
UPLOAD_MAX_PENDING_PER_USER=10

# Rolling validity window for presigned PUT upload URLs (integration direct upload).
# PRESIGNED_PUT_URL_TTL=1h

# Redis cache TTL for on-the-fly image transforms (/assets?w=&h=&fmt=)
# IMAGE_TRANSFORM_CACHE_TTL=24h

# Quota integration API key (không áp dụng cho /stream segments)
# API_KEY_UPLOAD_INIT_PER_MIN=120
# API_KEY_CONVERT_PER_HOUR=60

# Chỉ dùng khi chạy security tests: go test ./internal/handler/... -run TestSecurity_
# TEST_OWNER_EMAIL=
# TEST_OWNER_PASSWORD=
